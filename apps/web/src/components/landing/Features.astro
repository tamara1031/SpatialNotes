---
import en from "../../i18n/en.json";

const features = [
	{
		title: "End-to-End Encryption",
		description:
			"Your notes are encrypted in the browser before they ever touch our servers. We can't read your data, even if we wanted to.",
		icon: "🔒",
	},
	{
		title: "Infinite Spatial Canvas",
		description:
			"Organize your thoughts visually without boundaries. Zoom, pan, and connect ideas naturally.",
		icon: "🗺️",
	},
	{
		title: "Rich Markdown Support",
		description:
			"Write quickly with familiar markdown syntax, rendered beautifully in real-time as you type.",
		icon: "📝",
	},
	{
		title: "High-Performance Wasm",
		description:
			"Powered by Rust and WebAssembly, providing native-like performance for drawing and document processing.",
		icon: "⚡",
	},
	{
		title: "Local-First Architecture",
		description:
			"Work offline seamlessly. Your data syncs automatically in the background when you reconnect.",
		icon: "💾",
	},
	{
		title: "Real-time Collaboration",
		description:
			"Share securely with your team. See cursors and edits happen instantly across the globe.",
		icon: "🤝",
	},
];
---

<section id="features" class="features-section">
    <div class="container">
        <h2 class="section-title">{en.features.title}</h2>
        <p class="section-subtitle">{en.features.subtitle}</p>

        <div class="grid">
            {
                features.map((feature) => (
                    <div class="feature-card glass-panel">
                        <div class="feature-icon">{feature.icon}</div>
                        <h3 class="feature-title">{feature.title}</h3>
                        <p class="feature-description">{feature.description}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .features-section {
        padding: 6rem 2rem;
        background: var(--surface-raised);
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-title {
        text-align: center;
        font-size: clamp(2rem, 5vw, 3rem);
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .section-subtitle {
        text-align: center;
        font-size: 1.25rem;
        color: var(--text-secondary);
        margin-bottom: 4rem;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }

    .feature-card {
        padding: 2.5rem;
        border-radius: var(--radius-lg);
        transition: transform 0.2s;
    }

    .feature-card:hover {
        transform: translateY(-5px);
    }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
        background: var(--surface);
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 1rem;
        border: 1px solid var(--glass-border);
    }

    .feature-title {
        font-size: 1.25rem;
        margin-bottom: 1rem;
        color: var(--text-primary);
    }

    .feature-description {
        color: var(--text-secondary);
        line-height: 1.6;
    }
</style>
